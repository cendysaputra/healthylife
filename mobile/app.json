{
  "expo": {
    "name": "HealthyLife",
    "slug": "healthylife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cendysaputra.healthylife"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7500B4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cendysaputra.healthylife"
    },
    "scheme": "healthylife",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {}
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6897d8de-843f-4643-9b57-8c2e927aa136"
      }
    },
    "owner": "cendysaputra-team"
  }
}
